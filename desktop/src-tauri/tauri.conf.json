{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devance Anonymiseur",
  "version": "0.2.0",
  "identifier": "ca.devance.anonymizer",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Devance Anonymiseur",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 30 },
        "backgroundColor": "#f2f3f5"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "copyright": "© 2026 Devance",
    "shortDescription": "Anonymiser des documents avant de les confier à une IA",
    "longDescription": "Remplace les noms, adresses et numéros d'un document par des valeurs fictives réalistes, puis remet les vraies valeurs dans ce que l'IA vous rend. Tout reste sur votre ordinateur.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements/app.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"]
      }
    }
  }
}
